+        info.theta_min = min(info.theta_min,theta);
         Fstar(:,j) = feq + theta*(F(:,j)-feq);
         Fstar(:,j) = max(Fstar(:,j),0);
     elseif rhoj <= 0
+        info.negative_density_cells = info.negative_density_cells + 1;
